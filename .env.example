DB_PROVIDER=local

LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=your-local-mysql-user
LOCAL_DB_PASSWORD=your-local-mysql-password
LOCAL_DB_NAME=stockflow

TIDB_HOST=your-tidb-public-endpoint
TIDB_PORT=4000
TIDB_USER=your-tidb-user
TIDB_PASSWORD=your-tidb-password
TIDB_NAME=your-tidb-database
TIDB_CA_CERT_PATH=./certs/tidb-ca.pem

PORT=3000
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
